    {
      "shape": { "kind": "circle", "x": 640, "y": 360, "r": 150, "fill": "#0e1017", "stroke": "#5a8bff", "strokeWidth": 5 },
      "animations": [
        { "prop": "r", "from": 0, "to": 150, "start": 0.0, "end": 0.6, "easing": "easeOutBack" }
      ]
    },
    {
      "shape": { "kind": "text", "x": 640, "y": 366, "text": "5", "size": 150, "fill": "#e8eaf2", "align": "center", "baseline": "middle" },
      "animations": [
        { "prop": "opacity", "from": 0, "to": 1, "start": 0.0, "end": 0.5, "easing": "easeOutCubic" },
        { "prop": "size", "from": 150, "to": 60, "start": 1.0, "end": 1.9, "easing": "easeInCubic" }
      ]
    },
    {
      "shape": { "kind": "text", "x": 640, "y": 366, "text": "4", "size": 60, "fill": "#e8eaf2", "align": "center", "baseline": "middle" },
      "animations": [
        { "prop": "size", "from": 150, "to": 60, "start": 1.9, "end": 2.8, "easing": "easeInCubic" },
        { "prop": "opacity", "from": 0, "to": 1, "start": 1.9, "end": 2.15, "easing": "easeOutCubic" },
        { "prop": "opacity", "from": 1, "to": 0, "start": 2.8, "end": 2.95, "easing": "linear" }
      ]
    },
    {
      "shape": { "kind": "text", "x": 640, "y": 366, "text": "3", "size": 60, "fill": "#e8eaf2", "align": "center", "baseline": "middle" },
      "animations": [
        { "prop": "size", "from": 150, "to": 60, "start": 2.8, "end": 3.7, "easing": "easeInCubic" },
        { "prop": "opacity", "from": 0, "to": 1, "start": 2.8, "end": 3.05, "easing": "easeOutCubic" },
        { "prop": "opacity", "from": 1, "to": 0, "start": 3.7, "end": 3.85, "easing": "linear" }
      ]
    },
    {
      "shape": { "kind": "text", "x": 640, "y": 366, "text": "2", "size": 60, "fill": "#e8eaf2", "align": "center", "baseline": "middle" },
      "animations": [
        { "prop": "size", "from": 150, "to": 60, "start": 3.7, "end": 4.6, "easing": "easeInCubic" },
        { "prop": "opacity", "from": 0, "to": 1, "start": 3.7, "end": 3.95, "easing": "easeOutCubic" },
        { "prop": "opacity", "from": 1, "to": 0, "start": 4.6, "end": 4.75, "easing": "linear" }
      ]
    },
    {
      "shape": { "kind": "text", "x": 640, "y": 366, "text": "1", "size": 60, "fill": "#e8eaf2", "align": "center", "baseline": "middle" },
      "animations": [
        { "prop": "size", "from": 150, "to": 60, "start": 4.6, "end": 5.0, "easing": "easeInCubic" },
        { "prop": "opacity", "from": 0, "to": 1, "start": 4.6, "end": 4.85, "easing": "easeOutCubic" }
      ]
    },
    {
      "shape": { "kind": "text", "x": 640, "y": 620, "text": "每秒一个数字：缩小淡出接力，替换文案即得 GO! 收尾", "size": 20, "fill": "#6b7288", "align": "center", "baseline": "middle" },
      "animations": [
        { "prop": "opacity", "from": 0, "to": 1, "start": 4.2, "end": 4.9, "easing": "easeOutCubic" }
      ]
    }
  ]
